# Agent secrets. Never goes into the TOML and never goes into git.
# In production: /etc/meteo-agent/meteo-agent.env, permissions 0640 root:meteo.
#
# systemd reads this file as an EnvironmentFile: no "export", no quotes
# (they'd be taken literally), one KEY=VALUE per line.

# From @BotFather, /newbot command
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Write a message to your bot, then:  meteo-agent chat-id <TOKEN>
TELEGRAM_CHAT_ID=123456789

# Writer key: needed ONLY with [llm].enabled = true (false by default).
# The variable's name is set by [llm].api_key_env (default ANTHROPIC_API_KEY
# with provider = "anthropic"). From https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# Alternative, with [llm] provider = "openai" and api_key_env = "GITHUB_TOKEN":
# fine-grained PAT with the "Models: read" permission, from https://github.com/settings/tokens
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
